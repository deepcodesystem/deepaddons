<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_l10n_ma" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.l10n_ma_invoice_split</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="after">
                <block title="Facturation Espèces - Maroc (≤ 5000 DH)" name="l10n_ma_cash_invoice_settings">
                    <setting string="Partenaire par défaut (factures espèces)"
                             help="Partenaire utilisé automatiquement lors du fractionnement de factures pour paiements en espèces (législation marocaine ≤ 5000 DH TTC).">
                        <field name="l10n_ma_cash_invoice_partner_id"
                               options="{'no_quick_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>

