<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_inherit_ug" model="ir.ui.view">
        <field name="name">product.template.form.inherit.ug</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Ajouter le champ is_ug dans la section options, juste après "Peut être vendu" -->
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-flex">
                    <field name="is_ug"/>
                    <label for="is_ug" string="Unité Gratuite (UG)"/>
                </span>
            </xpath>
        </field>
    </record>
</odoo>

