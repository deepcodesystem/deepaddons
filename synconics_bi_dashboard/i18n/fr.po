#. module: synconics_bi_dashboard
#: model:mail.template,body_html:synconics_bi_dashboard.mail_template_dashboard_chart
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                Hello, <t/>\n"
"                <br/><br/>\n"
"                You have received mail related to the dashboard.\n"
"                    <br/><br/><br/>\n"
"                    <a t-att-href=\"ctx.get('url')\" style=\"border-radius:0px;margin:0px;cursor:pointer;appearance:button;text-transform:none;overflow-y:visible;overflow-x:visible;line-height:inherit;font-size:inherit;font-family:inherit;background-color: #714B67; padding: 6px 8px 6px 8px; text-decoration: none; color:#ffffff; border-radius: 10px; font-size:13px; font-weight: 700; border: 0px;\" class=\"o_default_snippet_text\">View Dashboard</a>\n"
"                    <br/><br/>\n"
"                    <t t-if=\"ctx.get('data')\">\n"
"                        <br/>\n"
"                        <t t-foreach=\"ctx['data']\" t-as=\"item\">\n"
"                            <p t-if=\"item.get('chart_type') not in ['tile', 'kpi']\">\n"
"                                <b>\n"
"                                    <t t-out=\"item['name'] or ''\"/>\n"
"                                </b>\n"
"                            </p>\n"
"                            <div style=\"margin: 16px 0px 16px 0px;\">\n"
"                                <img t-attf-src=\"{{item.get('image')}}\" style=\"padding: 0px; margin: 0px; height: auto;\"/>\n"
"                            </div>\n"
"                        </t>\n"
"                        <br/>\n"
"                    </t>\n"
"                Thank you.\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                Bonjour, <t/>\n"
"                <br/><br/>\n"
"                Vous avez reçu un courrier relatif au tableau de bord.\n"
"                    <br/><br/><br/>\n"
"                    <a t-att-href=\"ctx.get('url')\" style=\"border-radius:0px;margin:0px;cursor:pointer;appearance:button;text-transform:none;overflow-y:visible;overflow-x:visible;line-height:inherit;font-size:inherit;font-family:inherit;background-color: #714B67; padding: 6px 8px 6px 8px; text-decoration: none; color:#ffffff; border-radius: 10px; font-size:13px; font-weight: 700; border: 0px;\" class=\"o_default_snippet_text\">Voir le tableau de bord</a>\n"
"                    <br/><br/>\n"
"                    <t t-if=\"ctx.get('data')\">\n"
"                        <br/>\n"
"                        <t t-foreach=\"ctx['data']\" t-as=\"item\">\n"
"                            <p t-if=\"item.get('chart_type') not in ['tile', 'kpi']\">\n"
"                                <b>\n"
"                                    <t t-out=\"item['name'] or ''\"/>\n"
"                                </b>\n"
"                            </p>\n"
"                            <div style=\"margin: 16px 0px 16px 0px;\">\n"
"                                <img t-attf-src=\"{{item.get('image')}}\" style=\"padding: 0px; margin: 0px; height: auto;\"/>\n"
"                            </div>\n"
"                        </t>\n"
"                        <br/>\n"
"                    </t>\n"
"                Merci.\n"
"                </p>\n"
"            </div>"

