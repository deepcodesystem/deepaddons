<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_situation_report_wizard_form" model="ir.ui.view">
        <field name="name">payment.situation.report.wizard.form</field>
        <field name="model">payment.situation.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Situation de paiement par client">
                <group>
                    <group>
                        <field name="partner_ids" widget="many2many_tags" placeholder="Sélectionnez un ou plusieurs clients..."/>
                    </group>
                    <group>
                        <label for="date_from" string="Période"/>
                        <div class="o_row">
                            <field name="date_from"/> <span> - </span> <field name="date_to"/>
                        </div>
                    </group>
                </group>
                <footer>
                    <button name="action_print_report" string="Imprimer le rapport" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_payment_situation_report_wizard" model="ir.actions.act_window">
        <field name="name">Situation de paiement par client</field>
        <field name="res_model">payment.situation.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_payment_situation_report_wizard_form"/>
    </record>

    <menuitem id="menu_payment_situation_report"
              name="Situation de paiement par client"
              parent="account.menu_finance_receivables"
              action="action_payment_situation_report_wizard"
              sequence="90"/>
</odoo>
